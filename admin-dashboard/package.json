{
  "name": "odot-admin-dashboard",
  "version": "1.0.0",
  "description": "ODOT AWS Web Hosting Admin Dashboard — operational management UI for ECS services",
  "private": true,
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc && vite build",
    "start": "node dist/server/index.js",
    "test": "vitest run --reporter=verbose",
    "test:frontend": "vitest run --reporter=verbose src/",
    "test:backend": "vitest run --reporter=verbose server/",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-application-auto-scaling": "^3.500.0",
    "@aws-sdk/client-cloudwatch": "^3.500.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.500.0",
    "@aws-sdk/client-ecr": "^3.500.0",
    "@aws-sdk/client-ecs": "^3.500.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.500.0",
    "@aws-sdk/client-sns": "^3.500.0",
    "@aws-sdk/client-sts": "^3.500.0",
    "@aws-sdk/client-wafv2": "^3.500.0",
    "@aws-sdk/lib-dynamodb": "^3.500.0",
    "@aws-sdk/client-dynamodb": "^3.500.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.55.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.2",
    "vite": "^5.0.10",
    "vitest": "^1.1.0"
  }
}
