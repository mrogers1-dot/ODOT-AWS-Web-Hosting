{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyIAMAccessKeyCreation",
      "Effect": "Deny",
      "Action": [
        "iam:CreateAccessKey",
        "iam:CreateLoginProfile"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::*:role/odot-break-glass-*"
          ]
        }
      }
    }
  ]
}
